@model RaceDayMVC.Models.EnrolmentCreateVm

@{
    ViewData["Title"] = "Enter Race";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Enter Race Event</h3>
        </div>

        <div class="card-body">
            <h4>@Model.EventName</h4>
            <p class="text-muted">
                Select the category you would like to enter.
            </p>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }

            @if (Model.Categories != null && Model.Categories.Any())
            {
                <form asp-controller="Participant"
                      asp-action="EnterEvent"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           asp-for="EventId" />

                    <div class="mb-3">
                        <label asp-for="CategoryId"
                               class="form-label">
                            Select Race Category
                        </label>

                        <select asp-for="CategoryId"
                                class="form-select"
                                required>
                            <option value="">-- Choose a category --</option>

                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.Id">
                                    @category.Name
                                </option>
                            }
                        </select>

                        <span asp-validation-for="CategoryId"
                              class="text-danger"></span>
                    </div>

                    <button type="submit"
                            class="btn btn-success">
                        Confirm Race Entry
                    </button>

                    <a asp-action="Catalog"
                       class="btn btn-secondary ms-2">
                        Cancel
                    </a>
                </form>
            }
            else
            {
                <div class="alert alert-warning">
                    No categories are available for this race yet.
                    Please contact the organiser.
                </div>

                <a asp-action="Catalog"
                   class="btn btn-secondary">
                    Back to Events
                </a>
            }
        </div>
    </div>
</div>
