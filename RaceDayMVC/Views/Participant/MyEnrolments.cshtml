@model IEnumerable<RaceDayMVC.Models.EnrolmentVm>

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-4">
    <h2>My Enrolments</h2>
    <hr />

    @if (Model != null && Model.Any())
    {
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
                <tr>
                    <th>Event Name</th>
                    <th>Participant Email</th>
                    <th>Enrolled At</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var enr in Model)
                {
                    <tr>
                        <td>@enr.EventName</td>
                        <td>@enr.ParticipantEmail</td>
                        <td>@enr.EnrolledAt.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">You are not enrolled in any race events yet.</div>
    }
</div>