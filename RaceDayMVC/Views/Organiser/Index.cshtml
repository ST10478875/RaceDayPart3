@model IEnumerable<RaceDayMVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Organiser Dashboard - Managed Events</h2>
        <a asp-action="Create" class="btn btn-primary">+ Create New Event</a>
    </div>
    <hr />

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered mt-3">
                <thead class="table-dark">
                    <tr>
                        <th>Event Name</th>
                        <th>Description</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Distance (km)</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model)
                    {
                        <tr>
                            <td>@ev.Name</td>
                            <td>@ev.Description</td>
                            <td>@ev.Date.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@ev.Location</td>
                            <td>@ev.Distance</td>
                            <td class="text-center">
                                <a asp-action="Edit"
                                   asp-route-id="@ev.Id"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>

                                <a asp-action="Details"
                                   asp-route-id="@ev.Id"
                                   class="btn btn-sm btn-info">
                                    Details
                                </a>

                                <a asp-action="Categories"
                                   asp-route-eventId="@ev.Id"
                                   class="btn btn-sm btn-success">
                                    Manage Categories
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@ev.Id"
                                      method="post"
                                      style="display:inline;"
                                      onsubmit="return confirm('Are you sure you want to delete this event?');">
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-danger">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No events found or managed by you yet.
            Click "Create New Event" to add one.
        </div>
    }
</div>
